/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7581.dtsi"

/ {
	model = "Bell XG-040G-MD";
	compatible = "bell,xg-040g-md", "airoha,en7581";

	efuse-banks {
		compatible = "airoha,an7581-efuses";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		bank@0 {
			reg = <0x00>;
		};

		bank@1 {
			reg = <0x01>;
		};
	};

	aliases {
		serial0 = &uart1;
		led-boot = &pwr_led;
		led-failsafe = &pwr_led;
		led-running = &pwr_led;
		led-upgrade = &pwr_led;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8 loglevel=3 quiet earlycon";
		stdout-path = "serial0:115200n8";
		bootargs-append = " ubi.mtd=rootfs,2048 rootfstype=squashfs ubi.block=0,rootfs ro init=/etc/preinit irqaffinity=0,1,2,3 nohz=off rcu_nocbs=0-3 isolcpus=3 skew_tick=1";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x2 0x00000000>;
	};

	leds {
		compatible = "gpio-leds";

		pwr_led: led-0 {
			label = "blue:power";
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
		};

		pon_led: led-1 {
			label = "blue:pon";
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
		};

		los_led: led-2 {
			label = "red:los";
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_FAULT;
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		internet_led: led-3 {
			label = "blue:internet";
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 47>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
			drive-strength = <8>;
		};
	};

	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};

	gswp1_led0_pins: gswp1-led0-pins {
		mux {
			function = "phy1_led0";
			pins = "gpio33";
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio34";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio35";
		};
	};

	gswp4_led0_pins: gswp4-led0-pins {
		mux {
			function = "phy4_led0";
			pins = "gpio42";
		};
	};

	pwm_gpio18_idx10_pins: pwm-gpio18-idx10-pins {
		function = "pwm";
		pins = "gpio18";
		output-enable;
	};
};

&snfi {
	status = "okay";
	spi-max-frequency = <104000000>;
};


&spi_nand {
	#address-cells = <1>;
	#size-cells = <1>;
	spi-tx-bus-width = <4>;
	spi-rx-bus-width = <4>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x0  0x00080000>;
				read-only;
			};

			partition@80000  {
				label = "env";
				reg = <0x00080000 0x00080000>;
			};

			partition@100000 {
				label = "ubi";
				reg = <0x00100000  0x00>;
			};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
};

&eth {
	status = "okay";
	mediatek,eth-offload = "checksum", "tso", "lro";
};

&gdm1 {
	status = "okay";
	max-frame-size = <9000>;
};

&gdm4 {
	status = "okay";
	phy-handle = <&phy15>;
	phy-mode = "2500base-x";
	label = "wan";
	max-frame-size = <9000>;
	tx-queues = <8>;
	rx-queues = <8>;
};

&switch {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;

	ports {
		gsw_port2: port@2 {
			status = "okay";
			label = "lan2";
			pause;
		};

		gsw_port3: port@3 {
			status = "okay";
			label = "lan3";
			pause;
		};

		gsw_port4: port@4 {
			status = "okay";
			label = "lan4";
			pause;
		};
	};

	mdio {
		gsw_phy2: ethernet-phy@a {
			status = "okay";
			pinctrl-names = "gbe-led";
			pinctrl-0 = <&gswp2_led0_pins>;
			eee-broken-1000t;

			leds {
				led@0 {
					status = "okay";
					active-low;
					function = LED_FUNCTION_LAN;
					color = <LED_COLOR_ID_BLUE>;
				};
			};
		};

		gsw_phy3: ethernet-phy@b {
			status = "okay";
			pinctrl-names = "gbe-led";
			pinctrl-0 = <&gswp3_led0_pins>;
			eee-broken-1000t;

			leds {
				led@0 {
					status = "okay";
					active-low;
					function = LED_FUNCTION_LAN;
					color = <LED_COLOR_ID_BLUE>;
				};
			};
		};

		gsw_phy4: ethernet-phy@c {
			status = "okay";
			pinctrl-names = "gbe-led";
			pinctrl-0 = <&gswp4_led0_pins>;
			eee-broken-1000t;

			leds {
				led@0 {
					status = "okay";
					active-low;
					function = LED_FUNCTION_LAN;
					color = <LED_COLOR_ID_BLUE>;
				};
			};
		};

		phy15: ethernet-phy@f {
			/* Airoha EN8811H */
			compatible = "ethernet-phy-id03a2.a411", "ethernet-phy-ieee802.3-c22";
			reg = <15>;

			reset-gpios = <&en7581_pinctrl 31 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <2000000>;
			max-speed = <2500>;

			leds {
				#address-cells = <1>;
				#size-cells = <0>;

				led@0 {
					reg = <0>;
					function = LED_FUNCTION_WAN;
					color = <LED_COLOR_ID_BLUE>;
				};
			};
		};
	};
};

&usb0 {
	status = "okay";
	usb3-lpm-capable;
	maximum-speed = "super-speed";
};

&usb1 {
	status = "okay";
	usb3-lpm-capable;
	maximum-speed = "super-speed";
};

&npu {
	status = "okay";
};

&pcie0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_rst_pins>;
};

&pcie1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_rst_pins>;
};